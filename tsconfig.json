{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/lib/*": ["./registry/pumpgtm/subscription-state/*", "./registry/pumpgtm/cancel-flow/*"]
    }
  },
  "include": ["registry/**/*.ts", "test/**/*.ts"]
}
